# Leave NEXT_PUBLIC_API_URL empty to run the portal in demo mode (data stays in the browser).
# Set it to the deployed backend (e.g. https://api.example.in) to go live.
NEXT_PUBLIC_API_URL=
# Public URL of the site (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://geek-asr.github.io/iti-thane-women
# Sub-path when served from GitHub Pages project site; empty for a custom domain
NEXT_PUBLIC_BASE_PATH=
